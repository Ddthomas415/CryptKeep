{"artifact_type": "later_daily_mean_gap_sensitivity_v1", "not_fresh_holdout": true, "not_selection_adjusted": true, "not_promotion_evidence": true, "exclusions": "partial boundary days and final open liquidation; mark-to-market daily returns, not terminal return CI", "portfolio_sha256": "d4c299ff0a778b58c7d0f7e5f01f84f67c76bfabdc482d9edef653d0030dd8d6", "comparison_sha256": "cc55323722c9d53d0ccf3bf24477356f9fb905f43b745c2b50e8ca93c6181376", "source": "\"\"\"Paired later-period daily mean sensitivity, not selection-adjusted proof.\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport math\nimport random\nimport statistics\nfrom pathlib import Path\n\n\ndef paired_daily(left, right, start_timestamp, split):\n    a = {r[\"hour\"]: r[\"equity\"] for r in left}\n    b = {r[\"hour\"]: r[\"equity\"] for r in right}\n    hours = sorted(h for h in a.keys() & b.keys() if h >= split - 1)\n    if not hours:\n        raise ValueError(\"no aligned later valuations\")\n    # Reject incomplete interior evidence, rather than silently dropping bad days.\n    for h in range(hours[0], hours[-1] + 1):\n        if any(v is None or not math.isfinite(v) or v <= 0\n               for v in (a.get(h), b.get(h))):\n            raise ValueError(\"unknown later valuation\")\n    ends = [h for h in hours if (start_timestamp // 3600 + h) % 24 == 23]\n    pairs = [(h, a[h] / a[h - 24] - 1, b[h] / b[h - 24] - 1)\n             for h in ends if h - 24 >= split - 1 and h - 24 in a and h - 24 in b]\n    return pairs\n\n\ndef block_mean_gap(pairs, block, repeats=2000, seed=7):\n    gaps = [a - b for _, a, b in pairs]\n    if len(gaps) < block or block < 2:\n        return {\"status\": \"INSUFFICIENT_POWER\", \"days\": len(gaps)}\n    rng = random.Random(seed)\n    estimates = []\n    for _ in range(repeats):\n        indices = []\n        while len(indices) < len(gaps):\n            first = rng.randrange(len(gaps) - block + 1)\n            indices.extend(range(first, first + block))\n        estimates.append(statistics.mean(gaps[i] for i in indices[:len(gaps)]))\n    estimates.sort()\n    return {\"status\": \"DESCRIPTIVE\", \"days\": len(gaps), \"block_days\": block,\n            \"mean_daily_return_gap\": statistics.mean(gaps),\n            \"p025\": estimates[int(repeats * .025)], \"p975\": estimates[int(repeats * .975)],\n            \"repeats\": repeats, \"seed\": seed}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--portfolio\", type=Path, required=True)\n    parser.add_argument(\"--comparison\", type=Path, required=True)\n    parser.add_argument(\"--out\", type=Path, required=True)\n    args = parser.parse_args()\n    p_raw, b_raw = args.portfolio.read_bytes(), args.comparison.read_bytes()\n    p, b = json.loads(p_raw), json.loads(b_raw)\n    if hashlib.sha256(p_raw).hexdigest() != b[\"portfolio_sha256\"]:\n        raise ValueError(\"parent mismatch\")\n    lookup = {(r[\"volume_multiple\"], r[\"fee_bps\"]): r for r in b[\"results\"]}\n    results = []\n    for r in p[\"results\"]:\n        btc = lookup[(r[\"volume_multiple\"], r[\"fee_bps\"])]\n        pairs = paired_daily(r[\"curve\"], btc[\"btc\"][\"curve\"], p[\"start_timestamp\"], p[\"segment_split_hour\"])\n        results.append({\"volume_multiple\": r[\"volume_multiple\"], \"fee_bps\": r[\"fee_bps\"],\n                        \"paired_daily_returns\": pairs,\n                        \"sensitivity\": [block_mean_gap(pairs, k) for k in (14, 28)]})\n    output = {\"artifact_type\": \"later_daily_mean_gap_sensitivity_v1\",\n              \"not_fresh_holdout\": True, \"not_selection_adjusted\": True,\n              \"not_promotion_evidence\": True,\n              \"exclusions\": \"partial boundary days and final open liquidation; mark-to-market daily returns, not terminal return CI\",\n              \"portfolio_sha256\": hashlib.sha256(p_raw).hexdigest(),\n              \"comparison_sha256\": hashlib.sha256(b_raw).hexdigest(),\n              \"source\": Path(__file__).read_text(), \"results\": results}\n    with args.out.open(\"x\") as stream:\n        json.dump(output, stream, allow_nan=False)\n    print(json.dumps([{ \"volume_multiple\": r[\"volume_multiple\"], \"fee_bps\": r[\"fee_bps\"],\n                       \"sensitivity\": r[\"sensitivity\"]} for r in results]))\n\n\nif __name__ == \"__main__\":\n    main()\n", "results": [{"volume_multiple": 3, "fee_bps": 50.0, "paired_daily_returns": [[5855, 0.0, -0.02183816876398792], [5879, 0.0, -0.003831351785986592], [5903, 0.0, 0.03440160418008564], [5927, 0.0, -0.0003931506517427241], [5951, 0.0, 0.014031822945578032], [5975, 0.0, 0.01981422005497735], [5999, 0.0, 0.008677664442334754], [6023, 0.0, -0.00996064988050116], [6047, 0.0, -0.017839986930144547], [6071, 0.0, -0.024315380743331838], [6095, 0.0, 0.009481542409780053], [6119, 0.0, 0.011780821486186754], [6143, 0.0, -0.015373933851413613], [6167, 0.0, 0.011306600408661938], [6191, 0.0, -0.02041810078121209], [6215, 0.0, -0.026526198637845333], [6239, 0.0, -0.02098088438556689], [6263, 0.0, 0.005006059093539461], [6287, 0.0, -0.0011281190976448752], [6311, 0.0, -0.007688850091198907], [6335, 0.0, 0.011580184352795397], [6359, 0.0, -0.027239455390405398], [6383, 0.0, 0.024562943739424137], [6407, 0.0, 0.025392481335924977], [6431, 0.0, 0.016853159568941622], [6455, 0.0, 0.009056749960252963], [6479, 0.0, 0.00783036610872867], [6503, 0.0, 0.0066278245321989004], [6527, 0.0, -0.010602351432396406], [6551, 0.0, -0.017143302927975834], [6575, 0.0, 0.015064020681998302], [6599, 0.0, 0.01508882038456516], [6623, 0.0, -0.005542778256590775], [6647, 0.0, -0.0005130694726173113], [6671, 0.0, -0.02314673035842918], [6695, 0.0, 0.04374371837505975], [6719, 0.0, -0.004185500727511782], [6743, -0.015215476086064217, -0.014618035580653777], [6767, 0.004654824714616312, 0.0019350609842152533], [6791, -0.013030715918405544, 0.014122765830907547], [6815, 0.00021646837593092272, -0.001768309207492491], [6839, -0.00178