+@pytest.mark.parametrize("state_kind", ["last_action", "warmed", "trailing_peak"])
+@pytest.mark.parametrize("after_commit", [False, True])
+def test_failed_state_write_has_receipt_without_changing_old_failure_behavior(
+        recording_case, state_kind, after_commit):
+    snapshots = []
+    for enabled, before in ((False, True), (False, False), (True, False)):
+        with recording_case(enabled=enabled, before=before) as (h, inputs, capture):
+            inputs.fixed_price = 90.0
+            if state_kind == "trailing_peak":
+                h.seed_holdings()
+            real_set = h.runner.StrategyStateSQLite.set
+            failed_once = []
+
+            def failing(db, key, value):
+                if key == _key(h, state_kind, SYMBOLS[0]) and not failed_once:
+                    failed_once.append(key)
+                    if after_commit:
+                        real_set(db, key, value)
+                    raise OSError("synthetic state acknowledgement loss")
+                return real_set(db, key, value)
+
+            h.mp.setattr(h.runner.StrategyStateSQLite, "set", failing)
+            h.run(3)
+            assert failed_once
+            snapshots.append(_snapshot(h, inputs))
+            if enabled:
+                records = _records(h, capture, 3)
+                payload = records[0]["payload"]
+                assert payload["kind"] == "error" and payload["signal_computed"] is True
+                assert payload["signal"] == dict(inputs.observed_signals)[1]
+                assert payload["actual"]["outcome"] != "written"
+                assert capture.replay_runner_decision(records[0])["recomputed"] is False
+                assert all(r["payload"]["kind"] == "decision" for r in records[1:])
+    assert snapshots[0] == snapshots[1] == snapshots[2]
