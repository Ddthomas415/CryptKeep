+def _restore_signals(h):
+    # The shared harness replaces signals. Restore the exact source functions,
+    # not an imitation, while retaining its bounded loop and I/O isolation.
+    tree = ast.parse(h.source.read_text())
+    functions = [node for node in tree.body if isinstance(node, ast.FunctionDef)
+                 and node.name in {"_strategy_signal", "_registry_signal_with_context"}]
+    assert len(functions) == 2
+    exec(compile(ast.Module(body=functions, type_ignores=[]), str(h.source), "exec"),
+         h.runner.__dict__)
+    for name in ("_strategy_signal", "_registry_signal_with_context"):
+        assert Path(getattr(h.runner, name).__code__.co_filename) == h.source
+
+
+def _saved_module(mp, filename):
+    path = ARTIFACTS / filename
+    assert path.is_file(), f"required before artifact missing: {path}"
+    name = f"services.strategies._recording_before_{uuid.uuid4().hex}"
+    spec = importlib.util.spec_from_file_location(
+        name, path, loader=SourceFileLoader(name, str(path)))
+    module = importlib.util.module_from_spec(spec)
+    mp.setitem(sys.modules, name, module)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _restore_before_strategy_stack(h):
+    registry = _saved_module(h.mp, "services__strategies__strategy_registry.py.before")
+    for strategy, alias in (("ema_cross", "ema_cross"),
+                            ("breakout_donchian", "breakout_donchian"),
+                            ("mean_reversion_rsi", "mean_rev_rsi")):
+        old = _saved_module(h.mp, f"services__strategies__{strategy}.py.before")
+        setattr(registry, alias, old.signal_from_ohlcv)
+        registry.SUPPORTED[strategy] = old.signal_from_ohlcv
+    h.mp.setattr(h.runner, "compute_signal", registry.compute_signal)
+    exits = _saved_module(h.mp, "services__risk__exit_controls.py.before")
+    h.mp.setattr(h.runner, "evaluate_strategy_exit_stack", exits.evaluate_strategy_exit_stack)
+
