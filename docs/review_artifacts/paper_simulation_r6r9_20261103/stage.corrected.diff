+            inputs.fixed_price = 90.0
+            if filtered:
+                h.cfg["strategy"]["min_volume_ratio"] = 1000.0
+            h.seed_holdings()
+            for symbol in SYMBOLS:
+                h.state.set(_key(h, "trailing_peak", symbol), str(PRICES[symbol] * 1.2))
+            h.run(3)
+            snapshots.append(_snapshot(h, inputs))
+            assert len(h.intents("sell")) == 3
+            if enabled:
+                for record in _records(h, capture, 3):
+                    payload = record["payload"]
+                    assert payload["raw_signal"]["raw_action"] == "sell"
+                    assert payload["signal"]["action"] == ("hold" if filtered else "sell")
+                    if filtered:
+                        assert payload["signal"]["reason"] == "low_volume_filter"
+                    chosen = payload["decision"]["exit"]
+                    assert chosen["conditions"]["stop"] is True
+                    assert chosen["conditions"]["trailing"] is True
+                    assert chosen["conditions"]["pre_filter_sell"] is True
+                    assert chosen["conditions"]["strategy_sell"] is not filtered
+                    assert chosen["exit_out"]["stack_rule"] == "stop_loss"
+                    assert chosen["action"] == payload["actual"]["intended_action"] == "sell"
+                    assert payload["actual"]["outcome"] == "written"
+                    assert capture.replay_runner_decision(record)["decision_match"] is True
+    assert snapshots[0] == snapshots[1] == snapshots[2]
