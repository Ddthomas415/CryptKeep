+    directory = Path(envelope["object_directory"])
+    prefix = json.loads((directory / f"{payload['completed_prefix_sha256']}.json").read_bytes())
+    bars = [json.loads((directory / f"{ref}.json").read_bytes())["row"]
+            for ref in prefix["bar_refs"]]
