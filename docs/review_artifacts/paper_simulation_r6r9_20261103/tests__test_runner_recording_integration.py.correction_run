def _key(h, kind, symbol):
    return f"{kind}:{VENUE}:{symbol}:{h.cfg['strategy_id']}"


def _snapshot(h, inputs):
    import storage.strategy_state_sqlite as state

    with sqlite3.connect(state.DB_PATH) as db:
        values = db.execute("SELECT k, v FROM strategy_state ORDER BY k").fetchall()
    intents = sorted((r["symbol"], r["side"], r["qty"], r["order_type"], r["status"],
                      r["meta"]["reference_price"], r["meta"].get("reason"),
                      r["meta"].get("exit_stack_rule")) for r in h.intents())
    positions = sorted((p["symbol"], p["qty"], p["avg_price"]) for p in h.paper.list_positions())
    return {"signals": inputs.observed_signals, "state": values, "intents": intents,
            "positions": positions, "cash": h.paper.get_state("cash_quote")}


def _records(h, capture, count):
    paths = list((capture.data_dir() / "runner_decisions").glob("*/*.jsonl"))
    assert len(paths) == 1, (paths, h.statuses[-1])
    records = capture.read_runner_records(paths[0])
    assert len(records) == count, h.statuses[-1]
    expected_code = capture._runner_code_identity()
    for envelope in records:
        recorded_code = json.loads((Path(envelope["object_directory"]) / f"{envelope['payload']['code_sha256']}.json").read_bytes())
        assert recorded_code == expected_code, [
            (module, key) for module, bindings in expected_code["modules"].items()
            for key in bindings if recorded_code["modules"][module].get(key) != bindings[key]]
    assert [r["payload"]["loop"] for r in records] == list(range(1, count + 1))
    assert h.statuses[-1]["runner_decision_capture"] == {
        "enabled": True, "written": count, "failed": 0}
    return records


def _rows(envelope):
    payload = envelope["payload"]
    directory = Path(envelope["object_directory"])
    prefix = json.loads((directory / f"{payload['completed_prefix_sha256']}.json").read_bytes())
    bars = [json.loads((directory / f"{ref}.json").read_bytes())["row"]
            for ref in prefix["bar_refs"]]
    return [bars[slot["index"]] if slot["complete"] else slot["row"]
            for slot in payload["ohlcv"]]


def _export_summary(inputs, capture, records, *, recording_seconds, off_seconds=None):
    if not inputs.proof_output:
        return
    output = Path(inputs.proof_output).resolve()
    assert output.is_relative_to(ARTIFACTS.resolve()), "proof output must stay in approved artifact directory"
    output.mkdir(parents=True, exist_ok=True)
    journals = list((capture.data_dir() / "runner_decisions").glob("*/*.jsonl"))
    cas = list((capture.data_dir() / "signal_inputs").glob("*.json"))
    by_kind = {}
    by_object = {}
    for record in records:
        kind = record["payload"]["kind"]
        by_kind[kind] = by_kind.get(kind, 0) + 1
    for path in cas:
        kind = json.loads(path.read_bytes())["type"]
        item = by_object.setdefault(kind, {"objects": 0, "bytes": 0})
        item["objects"] += 1
        item["bytes"] += path.stat().st_size
    replays = [capture.replay_runner_decision(record) for record in records]
    summary = {
        "scope": "synthetic_clockhour_diagnostic_only_not_runtime_benchmark",
        "strategy": inputs.h.cfg["strategy_id"], "signal_source": inputs.h.cfg["signal_source"],
        "record_count": len(records), "by_kind": by_kind,
        "replay_matches": sum(r["decision_match"] is True for r in replays),
        "diagnostic_verified": sum(r["status"] == "diagnostic_verified" for r in replays),
        "stream_bytes": sum(p.stat().st_size for p in journals),
        "cas_bytes": sum(p.stat().st_size for p in cas), "cas_by_type": by_object,
        "synthetic_seconds": 3600, "poll_step_seconds": 60, "symbols": list(SYMBOLS),
        "recording_on_process_elapsed_seconds": recording_seconds,
        "recording_off_process_elapsed_seconds": off_seconds,
        "limits": ["Three symbols round robin, not nine single-symbol services",
                   "Includes cold-start code/settings/history; linear 26-week extrapolation is not a storage forecast",
                   "Tick bars are model timestamps, not observed market candles",
                   "Held duration is distinct-bar count, not elapsed hours",
                   "No runtime configuration, real fills, infrastructure cost or operational performance inspected"],
    }
    (output / f"synthetic_hour_{summary['strategy']}_{summary['signal_source']}.json").write_text(
        json.dumps(summary, sort_keys=True, indent=2) + "\n")


@pytest.mark.parametrize("strategy", TRIO)
@pytest.mark.parametrize("signal_source", SOURCES)
def test_recording_toggle_and_saved_before_have_identical_real_behavior(
        recording_case, strategy, signal_source):
    snapshots = []
    for enabled, before in ((False, True), (False, False), (True, False)):
        with recording_case(strategy, signal_source, enabled=enabled, before=before) as (h, inputs, capture):
            h.run(18)
            snapshots.append(_snapshot(h, inputs))
            assert len(inputs.observed_signals) == 18
            assert {signal["action"] for _, signal in inputs.observed_signals} >= {"buy", "sell"}
            assert h.intents("buy") and h.intents("sell"), "parity must exercise actions, not only idle state"
            if enabled:
                records = _records(h, capture, 18)
                assert [r["payload"]["signal"] for r in records] == [s for _, s in inputs.observed_signals]
                assert all(capture.replay_runner_decision(r)["decision_match"] for r in records)
            else:
                assert not list((capture.data_dir() / "runner_decisions").glob("*/*.jsonl"))
    assert snapshots[0] == snapshots[1] == snapshots[2]


@pytest.mark.parametrize("strategy", TRIO)
@pytest.mark.parametrize("signal_source", SOURCES)
def test_full_synthetic_clockhour_replays_every_turn_without_future_inputs(
        recording_case, strategy, signal_source):
    off_seconds = None
    off_snapshot = None
    if recording_case.proof_output:
        with recording_case(strategy, signal_source, enabled=False) as (h, inputs, _capture):
            inputs.stable_history = True
            started = time.perf_counter()
            h.run(61)
            off_seconds = time.perf_counter() - started
            off_snapshot = _snapshot(h, inputs)
    with recording_case(strategy, signal_source) as (h, inputs, capture):
        inputs.stable_history = True
        started = time.perf_counter()
        h.run(61)
        recording_seconds = time.perf_counter() - started
        records = _records(h, capture, 61)
        observed = [datetime.fromisoformat(r["payload"]["observed_at"]) for r in records]
        assert observed[0] == START and observed[-1] - observed[0] == timedelta(hours=1)
        assert {r["payload"]["symbol"] for r in records} == set(SYMBOLS)
        assert len({r["payload"]["session_id"] for r in records}) == 1
        actual_signals = dict(inputs.observed_signals)
        for envelope, (turn, symbol, supplied) in zip(records, inputs.seen, strict=True):
            payload = envelope["payload"]
            assert payload["kind"] == "decision" and payload["signal_computed"] is True
            assert payload["symbol"] == symbol and payload["loop"] == turn
            assert payload["signal"] == actual_signals[turn]
            rows = _rows(envelope)
            observed_ms = int(datetime.fromisoformat(payload["observed_at"]).timestamp() * 1000)
            assert all(row[0] <= observed_ms for row in rows)
            if signal_source == "public_ohlcv_1h":
                assert payload["timeframe"] == "1h"
                assert rows == supplied[-h.cfg["min_bars"]:]
                assert all(slot["complete"] == (row[0] + HOUR_MS <= observed_ms)
                           for slot, row in zip(payload["ohlcv"], rows, strict=True))
                assert payload["ohlcv"][-1]["complete"] is False
            else:
                assert payload["timeframe"] == "synthetic_ticks_1s"
                assert rows[-1][0] == supplied[1] and rows[-1][4] == supplied[0]
                assert all(slot["complete"] is False for slot in payload["ohlcv"])
            replay = capture.replay_runner_decision(envelope)
            assert replay["status"] == "decision_match", replay
            assert replay["recomputed"] is True and replay["signal_recomputed"] is True
        if signal_source == "public_ohlcv_1h":
            first, second = records[0], records[3]  # same symbol, changing forming bar
            assert first["payload"]["completed_prefix_sha256"] == second["payload"]["completed_prefix_sha256"]
            assert _rows(first)[-1] != _rows(second)[-1]
            assert _rows(first)[-1][4] == inputs.seen[0][2][-1][4]
        if off_snapshot is not None:
            assert _snapshot(h, inputs) == off_snapshot
        _export_summary(inputs, capture, records, recording_seconds=recording_seconds,
                        off_seconds=off_seconds)


@pytest.mark.parametrize("filtered", [False, True])
def test_simultaneous_stop_trailing_raw_sell_keeps_old_priority(recording_case, filtered):
    snapshots = []
    for enabled, before in ((False, True), (False, False), (True, False)):
        with recording_case(enabled=enabled, before=before) as (h, inputs, capture):
            inputs.fixed_price = 90.0
            if filtered:
                h.cfg["strategy"]["min_volume_ratio"] = 1000.0
            h.seed_holdings()
            for symbol in SYMBOLS:
                h.state.set(_key(h, "trailing_peak", symbol), str(PRICES[symbol] * 1.2))
            h.run(3)
            snapshots.append(_snapshot(h, inputs))
            assert len(h.intents("sell")) == 3
            if enabled:
                for record in _records(h, capture, 3):
                    payload = record["payload"]
                    assert payload["raw_signal"]["raw_action"] == "sell"
                    assert payload["signal"]["action"] == ("hold" if filtered else "sell")
                    if filtered:
                        assert payload["signal"]["reason"] == "low_volume_filter"
                    chosen = payload["decision"]["exit"]
                    assert chosen["conditions"]["stop"] is True
                    assert chosen["conditions"]["trailing"] is True
                    assert chosen["conditions"]["pre_filter_sell"] is True
                    assert chosen["conditions"]["strategy_sell"] is not filtered
                    assert chosen["exit_out"]["stack_rule"] == "stop_loss"
                    assert chosen["action"] == payload["actual"]["intended_action"] == "sell"
                    assert payload["actual"]["outcome"] == "written"
                    assert capture.replay_runner_decision(record)["decision_match"] is True
    assert snapshots[0] == snapshots[1] == snapshots[2]


@pytest.mark.parametrize("case", ["warming", "no_price", "pending", "cooldown", "fetch_error"])
@pytest.mark.parametrize("signal_source", SOURCES)
def test_skip_error_and_warming_receipts_truthfully_distinguish_signal_computation(
        recording_case, case, signal_source):
    with recording_case(signal_source=signal_source, seed_ticks=False) as (h, inputs, capture):
        if case == "warming":
            inputs.row_count = 2
        elif case == "no_price":
            inputs.empty = True
        elif case == "pending":
            h.consume = lambda: None
            h.seed_holdings()
            for symbol in SYMBOLS:
                identity = "pending-" + symbol.replace("/", "-")
                h.queue.upsert_intent({"intent_id": identity, "venue": VENUE,
                    "symbol": symbol, "side": "sell", "order_type": "market", "qty": 0.5,
                    "strategy_id": h.cfg["strategy_id"], "source": "strategy", "status": "queued",
                    "ts": datetime.now(timezone.utc).isoformat(),
                    "meta": {"paper_exit_policy": "retry_until_filled_v1", "paper_exit_id": identity,
                             "reference_price": PRICES[symbol]}})
        elif case == "cooldown":
            inputs.fixed_price = 110.0
            if signal_source == "synthetic_mid_ohlcv":
                for symbol in SYMBOLS:
                    h.state.set(_key(h, "prices", symbol), json.dumps([PRICES[symbol]] * 64))
            for symbol in SYMBOLS:
                h.state.set(_key(h, "kill_remaining", symbol), "10")
        else:
            def fail(*_a, **_kw):
                raise RuntimeError("synthetic input failure")
            h.mp.setattr(h.runner, "_fetch_mid" if signal_source == "synthetic_mid_ohlcv"
                         else "_fetch_public_ohlcv", fail)
        h.run(3)
        records = _records(h, capture, 3)
        for envelope in records:
            payload = envelope["payload"]
            replay = capture.replay_runner_decision(envelope)
            if case == "warming":
                # The accepted multi-symbol runner still manages held exits on
                # a fresh warmup quote, using its explicit default no_signal.
                assert payload["kind"] == "decision" and payload["signal_computed"] is False
                assert payload["signal"]["reason"] == "no_signal"
                assert replay["decision_match"] is True
                assert replay["recomputed"] is True and replay["signal_recomputed"] is False
            elif case == "cooldown":
                assert payload["kind"] == "decision"
                assert payload["actual"]["outcome"] == "kill_cooldown"
                assert payload["actual"]["gates"]["kill"]["ok"] is False
                assert replay["decision_match"] is True
            else:
                assert payload["kind"] == ("error" if case == "fetch_error" else "skipped")
                assert payload["signal_computed"] is False
                assert replay["status"] == "diagnostic_verified"
                assert replay["recomputed"] is False and replay["decision_match"] is None
                if case == "pending":
                    assert payload["pipeline_stage"] == "pending_exit"
                elif case == "no_price":
                    assert payload["reason"] == ("no_public_ohlcv" if signal_source == SOURCES[0]
                                                   else h.runner._no_fresh_tick_note())
        assert not h.intents("buy")


@pytest.mark.parametrize("after_commit", [False, True])
def test_queue_write_failure_receipt_preserves_uncertainty_and_other_symbols(
        recording_case, after_commit):
    with recording_case() as (h, inputs, capture):
        inputs.fixed_price = 110.0
        h.consume = lambda: None
        real_upsert = h.runner.IntentQueueSQLite.upsert_intent

        def failing(db, row):
            if row["symbol"] == SYMBOLS[0]:
                if after_commit:
                    real_upsert(db, row)
                raise OSError("synthetic acknowledgement loss")
            return real_upsert(db, row)

        h.mp.setattr(h.runner.IntentQueueSQLite, "upsert_intent", failing)
        h.run(3)
        records = _records(h, capture, 3)
        failed = records[0]["payload"]
        assert failed["kind"] == "error" and failed["signal_computed"] is True
        assert failed["actual"]["outcome"] == "write_failed_or_unknown"
        assert failed["actual"]["intended_action"] == "buy"
        assert (failed["actual"]["intent_id"] in {r["intent_id"] for r in h.intents()}) is after_commit
        assert all(r["payload"]["actual"]["outcome"] == "written" for r in records[1:])
        assert capture.replay_runner_decision(records[0])["recomputed"] is False
        assert {r["symbol"] for r in h.intents()} >= set(SYMBOLS[1:])


