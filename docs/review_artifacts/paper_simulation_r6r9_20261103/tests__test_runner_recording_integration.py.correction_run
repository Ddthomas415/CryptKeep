def _restore_signals(h):
    # The shared harness replaces signals. Restore the exact source functions,
    # not an imitation, while retaining its bounded loop and I/O isolation.
    tree = ast.parse(h.source.read_text())
    functions = [node for node in tree.body if isinstance(node, ast.FunctionDef)
                 and node.name in {"_strategy_signal", "_registry_signal_with_context"}]
    assert len(functions) == 2
    exec(compile(ast.Module(body=functions, type_ignores=[]), str(h.source), "exec"),
         h.runner.__dict__)
    for name in ("_strategy_signal", "_registry_signal_with_context"):
        assert Path(getattr(h.runner, name).__code__.co_filename) == h.source


def _saved_module(mp, filename):
    path = ARTIFACTS / filename
    assert path.is_file(), f"required before artifact missing: {path}"
    name = f"services.strategies._recording_before_{uuid.uuid4().hex}"
    spec = importlib.util.spec_from_file_location(
        name, path, loader=SourceFileLoader(name, str(path)))
    module = importlib.util.module_from_spec(spec)
    mp.setitem(sys.modules, name, module)
    spec.loader.exec_module(module)
    return module


def _restore_before_strategy_stack(h):
    registry = _saved_module(h.mp, "services__strategies__strategy_registry.py.before")
    for strategy, alias in (("ema_cross", "ema_cross"),
                            ("breakout_donchian", "breakout_donchian"),
                            ("mean_reversion_rsi", "mean_rev_rsi")):
        old = _saved_module(h.mp, f"services__strategies__{strategy}.py.before")
        setattr(registry, alias, old.signal_from_ohlcv)
        registry.SUPPORTED[strategy] = old.signal_from_ohlcv
    h.mp.setattr(h.runner, "compute_signal", registry.compute_signal)
    exits = _saved_module(h.mp, "services__risk__exit_controls.py.before")
    h.mp.setattr(h.runner, "evaluate_strategy_exit_stack", exits.evaluate_strategy_exit_stack)


class _Inputs:
    def __init__(self, h):
        self.h = h
        self.seen = []
        self.fixed_price = None
        self.empty = False
        self.row_count = 64
        self.stable_history = False
        self.observed_signals = []
        h.mp.setattr(h.runner, "_now", lambda: self.now().isoformat())
        h.mp.setattr(h.runner, "_fetch_public_ohlcv", self.public)
        h.mp.setattr(h.runner, "_fetch_mid", self.tick)
        # Observe returns without replacing the decision bindings under test.
        codes = {getattr(h.runner, name).__code__ for name in
                 ("_strategy_signal", "_registry_signal_with_context")}
        self.previous_profile = sys.getprofile()

        def returned(frame, event, result):
            if event == "return" and frame.f_code in codes and isinstance(result, dict):
                self.observed_signals.append((h.stop.turn, copy.deepcopy(result)))
            if self.previous_profile is not None:
                self.previous_profile(frame, event, result)

        sys.setprofile(returned)

    def now(self):
        return START + timedelta(seconds=60 * (max(1, self.h.stop.turn) - 1))

    def price(self, symbol):
        if self.fixed_price is not None:
            return self.fixed_price * PRICES[symbol] / PRICES[SYMBOLS[0]]
        moves = ((1.01, 0.99, 1.012, 0.988, 1.0)
                 if self.h.cfg["signal_source"] == SOURCES[0]
                 else (1.10, 0.90, 1.12, 0.88, 1.0))
        return PRICES[symbol] * moves[(self.h.stop.turn - 1) % len(moves)]

    def public(self, cfg, **_kwargs):
        symbol = cfg["symbol"]
        self.h.active_symbol = symbol
        now_ms = int(self.now().timestamp() * 1000)
        forming_open = now_ms // HOUR_MS * HOUR_MS
        rows = [] if self.empty else [
            [forming_open - (self.row_count - 1 - i) * HOUR_MS,
             PRICES[symbol], PRICES[symbol] * 1.003, PRICES[symbol] * 0.997, PRICES[symbol], 1.0]
            for i in range(self.row_count)
        ]
        if rows:
            price = self.price(symbol)
            if (not self.stable_history and self.h.cfg["strategy_id"] == "mean_reversion_rsi"
                    and len(rows) >= 24):
                # An oversold path with an actual final uptick, or its inverse,
                # exercises the public preset's unchanged reversal filter.
                direction = -1 if price < PRICES[symbol] else 1
                beginning = PRICES[symbol] * (1.0 - direction * 0.02)
                end = price + direction * PRICES[symbol] * 0.001
                for index in range(20):
                    close = beginning + (end - beginning) * index / 19
                    rows[-21 + index][1:5] = [close, close * 1.003, close * 0.997, close]
            rows[-1] = [forming_open, PRICES[symbol], max(price, PRICES[symbol]),
                        min(price, PRICES[symbol]), price, 1.0 + self.h.stop.turn]
        self.seen.append((self.h.stop.turn, symbol, copy.deepcopy(rows)))
        return rows, {"source": "public_ohlcv", "env_sample_mode": False,
                      "sample_fallback": False, "row_count": len(rows)}

    def tick(self, cfg):
        symbol = cfg["symbol"]
        self.h.active_symbol = symbol
        result = None if self.empty else (self.price(symbol), int(self.now().timestamp() * 1000))
        self.seen.append((self.h.stop.turn, symbol, result))
        return result


