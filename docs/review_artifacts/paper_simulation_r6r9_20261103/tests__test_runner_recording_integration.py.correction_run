                    failed_once.append(key)
                    if after_commit:
                        real_set(db, key, value)
                    raise OSError("synthetic state acknowledgement loss")
                return real_set(db, key, value)

            h.mp.setattr(h.runner.StrategyStateSQLite, "set", failing)
            h.run(3)
            assert failed_once
            snapshots.append(_snapshot(h, inputs))
            if enabled:
                records = _records(h, capture, 3)
                payload = records[0]["payload"]
                assert payload["kind"] == "error" and payload["signal_computed"] is True
                assert payload["signal"] == dict(inputs.observed_signals)[1]
                assert payload["actual"]["outcome"] != "written"
                assert capture.replay_runner_decision(records[0])["recomputed"] is False
                assert all(r["payload"]["kind"] == "decision" for r in records[1:])
    assert snapshots[0] == snapshots[1] == snapshots[2]


@pytest.mark.parametrize("failure", ["receipt", "exception"])
def test_capture_failure_is_diagnostic_not_trading_authority(recording_case, failure):
    snapshots = []
    for enabled in (False, True):
        with recording_case(enabled=enabled) as (h, inputs, capture):
            calls = []

            def fail(record, **_kwargs):
                calls.append(copy.deepcopy(record))
                if failure == "exception":
                    raise OSError("synthetic archive write failure")
                return {"ok": False, "status": "failed", "error_type": "OSError"}

            h.mp.setattr(capture, "capture_runner_decision", fail)
            h.run(9)
            snapshots.append(_snapshot(h, inputs))
            assert len(calls) == (9 if enabled else 0)
            assert h.statuses[-1]["runner_decision_capture"] == {
                "enabled": enabled, "written": 0, "failed": 9 if enabled else 0}
            assert not list((capture.data_dir() / "runner_decisions").glob("*/*.jsonl"))
    assert snapshots[0] == snapshots[1]


def test_zero_tick_timestamp_captures_exact_actual_synthetic_rows(recording_case):
    with recording_case(signal_source="synthetic_mid_ohlcv") as (h, inputs, capture):
        supplied_rows = []
        real_compute = h.runner.compute_signal
        clock_reads = []

        def moving_clock():
            stamp = inputs.now().timestamp() - 10 + len(clock_reads) * 0.001
            clock_reads.append(stamp)
            return stamp

        def compute(**kwargs):
            supplied_rows.append(copy.deepcopy(kwargs["ohlcv"]))
            return real_compute(**kwargs)

        def tick(cfg):
            h.active_symbol = cfg["symbol"]
            return inputs.price(cfg["symbol"]), 0

        h.mp.setattr(h.runner.time, "time", moving_clock)
        h.mp.setattr(h.runner, "compute_signal", compute)
        h.mp.setattr(h.runner, "_fetch_mid", tick)
        h.run(6)
        assert len(supplied_rows) == 6 and len(clock_reads) >= 6
        records = _records(h, capture, 6)
        for envelope, rows in zip(records, supplied_rows, strict=True):
            assert _rows(envelope) == rows
            assert envelope["payload"]["timeframe"] == "synthetic_ticks_1s"
            assert capture.replay_runner_decision(envelope)["decision_match"] is True
