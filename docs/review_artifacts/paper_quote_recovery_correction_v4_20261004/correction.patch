diff --git a/services/strategies/evidence_write_lock.py b/services/strategies/evidence_write_lock.py
new file mode 100644
index 000000000..fe7337c12
--- /dev/null
+++ b/services/strategies/evidence_write_lock.py
@@ -0,0 +1,34 @@
+from contextlib import contextmanager
+import sqlite3
+import threading
+
+from services.os.app_paths import data_dir
+
+_THREAD_LOCK = threading.RLock()
+_LOCAL = threading.local()
+
+
+@contextmanager
+def serialized_evidence_write():
+    """Serialize cooperating evidence writers across threads and processes."""
+    if not _THREAD_LOCK.acquire(timeout=0.1):
+        raise TimeoutError("evidence_writer_busy")
+    try:
+        if getattr(_LOCAL, "active", False):
+            yield
+            return
+        path = data_dir() / "evidence" / "write_lock.sqlite"
+        path.parent.mkdir(parents=True, exist_ok=True)
+        con = sqlite3.connect(str(path), timeout=0.1)
+        try:
+            con.execute("BEGIN IMMEDIATE")
+            _LOCAL.active = True
+            try:
+                yield
+            finally:
+                _LOCAL.active = False
+                con.rollback()
+        finally:
+            con.close()
+    finally:
+        _THREAD_LOCK.release()
diff --git a/tests/test_paper_recovery_runtime.py b/tests/test_paper_recovery_runtime.py
