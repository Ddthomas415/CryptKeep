--- /dev/null
+++ b/tests/test_paper_recovery_runtime.py
@@ -0,0 +1,119 @@
+import importlib
+import sqlite3
+from concurrent.futures import ThreadPoolExecutor
+import threading
+
+from tests.test_paper_fill_evidence_backfill import (
+    rig, _submit, _kill_during_evidence_write, _fill_records,
+)
+
+
+def test_runner_continues_recovery_without_restart(rig, monkeypatch):
+    pe, ev_dir = rig
+    engine = pe.PaperEngine()
+    first = _submit(engine, 'runtime-first', 'buy')
+    _kill_during_evidence_write(monkeypatch, engine)
+    second = _submit(engine, 'runtime-second', 'buy')
+    _kill_during_evidence_write(monkeypatch, engine)
+    from services.strategies.evidence_logger import EvidenceLogger
+    original_log = EvidenceLogger.log_fill
+    attempted = []
+
+    def once_bad(self, **kwargs):
+        attempted.append(kwargs['order_id'])
+        if len(attempted) == 1:
+            raise OSError('temporary storage fault')
+        return original_log(self, **kwargs)
+
+    monkeypatch.setattr(EvidenceLogger, 'log_fill', once_bad)
+    original_sweep = engine.backfill_fill_evidence
+    monkeypatch.setattr(engine, 'backfill_fill_evidence', lambda: original_sweep(limit=1))
+    monkeypatch.setattr(engine, 'evaluate_open_orders', lambda: {})
+    monkeypatch.setattr(engine, 'mark_to_market', lambda *args: {})
+    from services.execution import paper_runner
+    importlib.reload(paper_runner)
+    monkeypatch.setattr(paper_runner, 'PaperEngine', lambda: engine)
+    monkeypatch.setattr(paper_runner, 'load_user_yaml', lambda: {})
+    monkeypatch.setattr(paper_runner, '_consume_queued_intents_once', lambda **kwargs: {})
+    monkeypatch.setattr(paper_runner, 'reconcile_once', lambda **kwargs: {})
+    loops = []
+
+    def sleep(_seconds):
+        loops.append(1)
+        if len(loops) == 2:
+            paper_runner.STOP_FILE.write_text('stop', encoding='utf-8')
+
+    monkeypatch.setattr(paper_runner.time, 'sleep', sleep)
+    paper_runner.run_forever()
+    assert {first, second} <= {r['order_id'] for r in _fill_records(ev_dir)}
+    assert attempted == [first, second, first]
+    assert not paper_runner.LOCK_FILE.exists()
+
+
+def test_contended_write_lock_defers_then_recovers(rig, monkeypatch):
+    pe, ev_dir = rig
+    engine = pe.PaperEngine()
+    first = _submit(engine, 'locked', 'buy')
+    _kill_during_evidence_write(monkeypatch, engine)
+    from services.os.app_paths import data_dir
+    path = data_dir() / 'evidence' / 'write_lock.sqlite'
+    con = sqlite3.connect(str(path))
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        assert engine.backfill_fill_evidence()['ok'] is False
+        assert _fill_records(ev_dir) == []
+    finally:
+        con.rollback()
+        con.close()
+    assert engine.backfill_fill_evidence()['backfilled'] == 1
+    assert [r['order_id'] for r in _fill_records(ev_dir)] == [first]
+
+
+def test_silent_logger_failure_is_not_reported_as_recovered(rig, monkeypatch):
+    pe, ev_dir = rig
+    engine = pe.PaperEngine()
+    first = _submit(engine, 'silent', 'buy')
+    _kill_during_evidence_write(monkeypatch, engine)
+    from services.strategies.evidence_logger import EvidenceLogger
+    with monkeypatch.context() as patch:
+        patch.setattr(EvidenceLogger, 'log_fill', lambda *args, **kwargs: None)
+        result = engine.backfill_fill_evidence()
+        assert result['ok'] is False and result['backfilled'] == 0
+        assert result['failed_order_ids'] == [first]
+    assert engine.backfill_fill_evidence()['backfilled'] == 1
+
+
+def test_concurrent_logger_appends_preserve_both_records(rig, monkeypatch):
+    _, ev_dir = rig
+    from services.strategies import evidence_logger
+    monkeypatch.setattr(evidence_logger, '_version_stamp', lambda *args: {})
+    monkeypatch.setattr(evidence_logger, '_sample_provenance_stamp', lambda: {})
+    barrier = threading.Barrier(2)
+
+    def write(index):
+        barrier.wait()
+        evidence_logger.EvidenceLogger('es_daily_trend_v1').log_fill(
+            timestamp='2026-10-04T00:00:00+00:00', fill_price=100.0,
+            slippage_points=0.0, slippage_pct=0.0, fees_paid=0.0,
+            order_id=f'concurrent-{index}', size=1.0)
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        list(pool.map(write, range(2)))
+    assert {r['order_id'] for r in _fill_records(ev_dir)} == {'concurrent-0', 'concurrent-1'}
+
+
+def test_recovery_between_ledger_commit_and_normal_log_is_not_duplicated(rig, monkeypatch):
+    pe, ev_dir = rig
+    engine = pe.PaperEngine()
+    order = _submit(engine, 'interleaved', 'buy')
+    original = engine.db.apply_fill
+
+    def commit_then_recover(**kwargs):
+        result = original(**kwargs)
+        assert pe.PaperEngine().backfill_fill_evidence()['backfilled'] == 1
+        return result
+
+    monkeypatch.setattr(engine.db, 'apply_fill', commit_then_recover)
+    assert engine.evaluate_open_orders()['filled'] == 1
+    assert len(engine.db.list_fills()) == 1
+    assert [r['order_id'] for r in _fill_records(ev_dir)] == [order]
