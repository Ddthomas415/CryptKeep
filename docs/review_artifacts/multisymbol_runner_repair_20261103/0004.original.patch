+def test_exit_resumes_when_the_quote_recovers(monkeypatch, tmp_path):
+    # BTC quotes 100, then nothing for two turns, then 90: the stop must fire
+    # on the recovered quote and only then.
+    quotes = {1: 100.0, 4: 90.0}
+    runner, emitted, _ = _setup(
+        monkeypatch, tmp_path,
+        signals={"BTC/USD": BUY, "ETH/USD": HOLD},
+        mids={"BTC/USD": lambda n: quotes.get(n), "ETH/USD": 10.0},
+        positions={"BTC/USD": (1.0, 100.0)},
+        cfg_extra={"stop_loss_pct": 0.03},
+    )
+    state = runner.StrategyStateSQLite()
+    state.set(f"last_action:{_key('BTC/USD')}", "buy")
+    state.set(f"last_emitted_action:{_key('BTC/USD')}", "buy")
+    calls = _count_exit_evaluations(monkeypatch, runner)
+
+    _run(monkeypatch, runner, loops=6)  # BTC turns 1-3: 100, none, none
+    assert calls == [100.0] and emitted == []
+
+    _run(monkeypatch, runner, loops=2)  # BTC turn 4: 90
+    assert [(row["symbol"], row["side"]) for row in emitted] == [("BTC/USD", "sell")]
+    assert calls[-1] == 90.0
