diff --git a/tests/test_runner_multi_symbol.py b/tests/test_runner_multi_symbol.py
new file mode 100644
index 00000000..5944684b
--- /dev/null
+++ b/tests/test_runner_multi_symbol.py
@@ -0,0 +1,395 @@
+"""With several symbols, every symbol must be decided, gated and exited on its own.
+
+Before this change the decision, kill gate and emission ran once per loop,
+after the per-symbol data loop, so only the last configured symbol was acted on
+and it could be managed with another symbol's price.
+"""
+from __future__ import annotations
+
+from tests.test_strategy_runtime_runner import _reload_strategy_runner
+
+BUY = {"ok": True, "action": "buy", "signal": "long", "reason": "test:long"}
+HOLD = {"ok": True, "action": "hold", "signal": "flat", "reason": "test:flat"}
+SYMBOLS = ["BTC/USD", "ETH/USD"]
+
+
+def _key(symbol, strategy="sma_200_trend"):
+    return f"coinbase:{symbol}:{strategy}"
+
+
+def _setup(monkeypatch, tmp_path, *, signals, mids, positions=None, cfg_extra=None):
+    runner = _reload_strategy_runner(monkeypatch, tmp_path)
+    emitted: list[dict] = []
+    positions = dict(positions or {})
+
+    class Queue:
+        def has_open_strategy_intent(self, symbol):
+            return False
+
+        def list_intents(self, **kwargs):
+            return []
+
+        def upsert_intent(self, row):
+            emitted.append(dict(row))
+            if row["side"] == "sell":
+                positions[row["symbol"]] = (0.0, 0.0)
+
+    class Paper:
+        def get_position(self, symbol):
+            qty, avg = positions.get(symbol, (0.0, 0.0))
+            return {"qty": qty, "avg_price": avg, "symbol": symbol}
+
+    monkeypatch.setattr(runner, "IntentQueueSQLite", Queue)
+    monkeypatch.setattr(runner, "PaperTradingSQLite", Paper)
+    monkeypatch.setattr(runner, "collect_runtime_rows", lambda **kw: ([], []))
+    cfg = dict(
+        enabled=True, strategy_id="sma_200_trend", strategy={"name": "sma_200_trend"},
+        strategy_preset="es_daily_trend_v1", venue="coinbase", symbol="BTC/USD", symbols=list(SYMBOLS),
+        fast_n=2, slow_n=4, min_bars=1, max_bars=20, loop_interval_sec=0.0, qty=0.5,
+        order_type="market", allow_first_signal_trade=False, use_ccxt_fallback=False,
+        max_tick_age_sec=5.0, position_aware=True, sell_full_position=True,
+        signal_source="synthetic_mid_ohlcv", auto_select_best_venue=False,
+        switch_only_when_blocked=True, venue_candidates=[],
+        stop_loss_pct=0.0, take_profit_pct=0.0, trailing_stop_pct=0.0, max_bars_hold=0,
+    )
+    cfg.update(cfg_extra or {})
+    monkeypatch.setattr(runner, "_cfg", lambda: dict(cfg))
+    calls = {symbol: 0 for symbol in cfg["symbols"]}
+
+    def fetch_mid(sym_cfg):
+        symbol = sym_cfg["symbol"]
+        calls[symbol] += 1
+        source = mids[symbol]
+        value = source(calls[symbol]) if callable(source) else source
+        return None if value is None else (float(value), 1)
+
+    monkeypatch.setattr(runner, "_fetch_mid", fetch_mid)
+    monkeypatch.setattr(runner, "_strategy_signal", lambda sym_cfg, prices, ts_ms=None: dict(signals[sym_cfg["symbol"]]))
+    monkeypatch.setattr(runner, "require_known_flat_or_override", lambda *, venue, symbol: None)
+    state = runner.StrategyStateSQLite()
+    for symbol in SYMBOLS:
+        state.set(f"warmed:{_key(symbol)}", "1")
+        state.set(f"last_action:{_key(symbol)}", "hold")
+    return runner, emitted, state
+
+
+def _run(monkeypatch, runner, *, loops):
+    """Run exactly ``loops`` iterations of the outer loop (one symbol per iteration)."""
+    seen = {"n": 0}
+    if runner.STOP_FILE.exists():
+        runner.STOP_FILE.unlink()
+    monkeypatch.setattr(runner.time, "sleep", lambda _s: None)
+    real_get = runner.StrategyStateSQLite.get
+
+    def counting_get(self, key):
+        # Every turn reads its symbol's "warmed" flag once; the stop file is
+        # honoured at the top of the following iteration.
+        if str(key).startswith("warmed:"):
+            seen["n"] += 1
+            if seen["n"] >= loops:
+                runner.STOP_FILE.parent.mkdir(parents=True, exist_ok=True)
+                runner.STOP_FILE.write_text("stop")
+        return real_get(self, key)
+
+    monkeypatch.setattr(runner.StrategyStateSQLite, "get", counting_get)
+    runner.run_forever()
+    monkeypatch.setattr(runner.StrategyStateSQLite, "get", real_get)
+    assert seen["n"] == loops
+
+
+def test_every_symbol_gets_its_entry(monkeypatch, tmp_path):
+    runner, emitted, _ = _setup(
+        monkeypatch, tmp_path,
+        signals={"BTC/USD": BUY, "ETH/USD": BUY}, mids={"BTC/USD": 100.0, "ETH/USD": 10.0},
+    )
+
+    _run(monkeypatch, runner, loops=6)
+
+    assert sorted((row["symbol"], row["side"]) for row in emitted) == [("BTC/USD", "buy"), ("ETH/USD", "buy")]
+
+
+def test_first_symbol_is_acted_on_when_only_it_signals(monkeypatch, tmp_path):
+    runner, emitted, _ = _setup(
+        monkeypatch, tmp_path,
+        signals={"BTC/USD": BUY, "ETH/USD": HOLD}, mids={"BTC/USD": 100.0, "ETH/USD": 10.0},
+    )
+
+    _run(monkeypatch, runner, loops=6)
+
+    assert [(row["symbol"], row["side"]) for row in emitted] == [("BTC/USD", "buy")]
+
+
+def test_each_symbol_counts_down_its_own_cooldown(monkeypatch, tmp_path):
+    runner, emitted, state = _setup(
+        monkeypatch, tmp_path,
+        signals={"BTC/USD": BUY, "ETH/USD": BUY}, mids={"BTC/USD": 100.0, "ETH/USD": 10.0},
+    )
+    state.set(f"kill_remaining:{_key('BTC/USD')}", "10")
+    state.set(f"kill_remaining:{_key('ETH/USD')}", "3")
+
+    _run(monkeypatch, runner, loops=8)  # four turns each
+
+    assert state.get(f"kill_remaining:{_key('BTC/USD')}") == "6"
+    assert state.get(f"kill_remaining:{_key('ETH/USD')}") == "0"
+    assert emitted == []  # both entry changes arrived inside their cooldowns
+
+
+def test_symbol_is_not_managed_with_another_symbols_price(monkeypatch, tmp_path):
+    # BTC long at 100 with a 3% stop. BTC quotes once, then its feed goes quiet;
+    # ETH keeps quoting 10. BTC must not be stopped out at ETH's price, and its
+    # own earlier quote must not be reused either.
+    runner, emitted, _ = _setup(
+        monkeypatch, tmp_path,
+        signals={"BTC/USD": BUY, "ETH/USD": HOLD},
+        mids={"BTC/USD": lambda n: 100.0 if n == 1 else None, "ETH/USD": 10.0},
+        positions={"BTC/USD": (1.0, 100.0)},
+        cfg_extra={"stop_loss_pct": 0.03},
+    )
+    state = runner.StrategyStateSQLite()
+    state.set(f"last_action:{_key('BTC/USD')}", "buy")
+    state.set(f"last_emitted_action:{_key('BTC/USD')}", "buy")
+
+    _run(monkeypatch, runner, loops=8)
+
+    assert emitted == []
+
+
+def test_stop_loss_fires_for_the_first_symbol_at_its_own_price(monkeypatch, tmp_path):
+    runner, emitted, _ = _setup(
+        monkeypatch, tmp_path,
+        signals={"BTC/USD": BUY, "ETH/USD": HOLD},
+        mids={"BTC/USD": lambda n: 100.0 if n == 1 else 90.0, "ETH/USD": 10.0},
+        positions={"BTC/USD": (1.0, 100.0)},
+        cfg_extra={"stop_loss_pct": 0.03},
+    )
+    state = runner.StrategyStateSQLite()
+    state.set(f"last_action:{_key('BTC/USD')}", "buy")
+    state.set(f"last_emitted_action:{_key('BTC/USD')}", "buy")
+
+    _run(monkeypatch, runner, loops=8)
+
+    assert [(row["symbol"], row["side"], row["qty"]) for row in emitted] == [("BTC/USD", "sell", 1.0)]
+
+
+def test_symbol_without_any_price_is_skipped_and_others_still_trade(monkeypatch, tmp_path):
+    runner, emitted, state = _setup(
+        monkeypatch, tmp_path,
+        signals={"BTC/USD": BUY, "ETH/USD": BUY}, mids={"BTC/USD": None, "ETH/USD": 10.0},
+    )
+
+    _run(monkeypatch, runner, loops=6)
+
+    assert [(row["symbol"], row["side"]) for row in emitted] == [("ETH/USD", "buy")]
+    assert state.get(f"last_action:{_key('BTC/USD')}") == "hold"
+
+
+def test_open_position_without_any_price_is_not_exited_on_another_symbols_price(monkeypatch, tmp_path):
+    # BTC is long at 100 with a 3% stop but has produced no price in this
+    # process. ETH quotes 10. BTC must be left alone, not stopped out at 10.
+    runner, emitted, _ = _setup(
+        monkeypatch, tmp_path,
+        signals={"BTC/USD": BUY, "ETH/USD": HOLD}, mids={"BTC/USD": None, "ETH/USD": 10.0},
+        positions={"BTC/USD": (1.0, 100.0)},
+        cfg_extra={"stop_loss_pct": 0.03, "symbols": ["ETH/USD", "BTC/USD"]},
+    )
+    state = runner.StrategyStateSQLite()
+    state.set(f"last_action:{_key('BTC/USD')}", "buy")
+    state.set(f"last_emitted_action:{_key('BTC/USD')}", "buy")
+
+    _run(monkeypatch, runner, loops=8)
+
+    assert emitted == []
+
+
+def test_position_is_still_exited_while_its_signal_is_warming_up(monkeypatch, tmp_path):
+    # ETH is long at 10 with a 3% stop and quotes 5, but has too few bars for a
+    # signal. The fresh price must still reach the exit stack.
+    runner, emitted, _ = _setup(
+        monkeypatch, tmp_path,
+        signals={"BTC/USD": HOLD, "ETH/USD": HOLD}, mids={"BTC/USD": 100.0, "ETH/USD": 5.0},
+        positions={"ETH/USD": (2.0, 10.0)},
+        cfg_extra={"stop_loss_pct": 0.03, "min_bars": 50},
+    )
+    state = runner.StrategyStateSQLite()
+    state.set(f"last_emitted_action:{_key('ETH/USD')}", "buy")
+
+    _run(monkeypatch, runner, loops=6)
+
+    assert [(row["symbol"], row["side"], row["qty"]) for row in emitted] == [("ETH/USD", "sell", 2.0)]
+
+
+def test_quiet_second_symbol_is_not_managed_on_any_other_price(monkeypatch, tmp_path):
+    # ETH (second) is long at 10 with a 3% stop, quotes 10 once and then goes
+    # quiet. BTC (first) keeps quoting 5. ETH must not be stopped out at 5.
+    runner, emitted, _ = _setup(
+        monkeypatch, tmp_path,
+        signals={"BTC/USD": HOLD, "ETH/USD": BUY},
+        mids={"BTC/USD": 5.0, "ETH/USD": lambda n: 10.0 if n == 1 else None},
+        positions={"ETH/USD": (2.0, 10.0)},
+        cfg_extra={"stop_loss_pct": 0.03},
+    )
+    state = runner.StrategyStateSQLite()
+    state.set(f"last_action:{_key('ETH/USD')}", "buy")
+    state.set(f"last_emitted_action:{_key('ETH/USD')}", "buy")
+
+    _run(monkeypatch, runner, loops=10)
+
+    assert emitted == []
+
+
+def _use_public_ohlcv(monkeypatch, runner, *, candles, signals):
+    """Daily public-OHLCV mode (the production signal source), per symbol."""
+    monkeypatch.setattr(runner, "load_user_yaml", lambda **kwargs: {"strategy_runner": {"strategy": {"name": "sma_200_trend"}}})
+    monkeypatch.setattr(
+        runner, "_fetch_public_ohlcv",
+        lambda sym_cfg, **kwargs: (
+            [list(row) for row in candles[sym_cfg["symbol"]]],
+            {"source": "public_ohlcv", "sample_path": None, "sample_fallback": False,
+             "row_count": len(candles[sym_cfg["symbol"]]), "env_sample_mode": False},
+        ),
+    )
+    monkeypatch.setattr(runner, "_market_quality_evidence_extra", lambda venue, symbol: {})
+    monkeypatch.setattr(
+        runner, "_registry_signal_with_context",
+        lambda *, cfg, strategy_block, symbol, venue, ohlcv: dict(signals[symbol]),
+    )
+
+
+def _candles(close, *, n=3):
+    day = 86_400_000
+    return [[(i + 1) * day, close, close, close, close, 1.0] for i in range(n)]
+
+
+def test_public_ohlcv_mode_enters_every_symbol(monkeypatch, tmp_path):
+    signals = {"BTC/USD": BUY, "ETH/USD": BUY}
+    runner, emitted, _ = _setup(
+        monkeypatch, tmp_path, signals=signals, mids={"BTC/USD": None, "ETH/USD": None},
+        cfg_extra={"signal_source": "public_ohlcv_1d"},
+    )
+    _use_public_ohlcv(monkeypatch, runner, candles={"BTC/USD": _candles(100.0), "ETH/USD": _candles(10.0)}, signals=signals)
+
+    _run(monkeypatch, runner, loops=6)
+
+    assert sorted((row["symbol"], row["side"]) for row in emitted) == [("BTC/USD", "buy"), ("ETH/USD", "buy")]
+
+
+def test_public_ohlcv_mode_stops_out_first_symbol_at_its_own_close(monkeypatch, tmp_path):
+    signals = {"BTC/USD": BUY, "ETH/USD": HOLD}
+    runner, emitted, _ = _setup(
+        monkeypatch, tmp_path, signals=signals, mids={"BTC/USD": None, "ETH/USD": None},
+        positions={"BTC/USD": (1.0, 100.0)},
+        cfg_extra={"signal_source": "public_ohlcv_1d", "stop_loss_pct": 0.03},
