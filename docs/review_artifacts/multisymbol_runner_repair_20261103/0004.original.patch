+def _count_exit_evaluations(monkeypatch, runner):
+    calls: list[float] = []
+    real = runner.evaluate_strategy_exit_stack
+
+    def counting(**kwargs):
+        calls.append(float(kwargs["current_price"]))
+        return real(**kwargs)
+
+    monkeypatch.setattr(runner, "evaluate_strategy_exit_stack", counting)
+    return calls
+
