+def _kill_remaining_loops(sdb, k_kill_remaining: str, k_kill_until: str, *, max_cooldown_loops: int) -> int:
+    """Blocked loops still owed for a symbol, counted across runner processes.
+
+    ``kill_until`` used to hold an absolute loop number, but the loop counter
+    restarts in every process, so a persisted value blocked the first loops of
+    every later session. A leftover legacy value is converted once: loops below
+    it were blocked. No stored value may block longer than the longest
+    configured cooldown. The count is written before the legacy value is
+    cleared, so an interrupted conversion repeats rather than drops the block.
+    """
+    longest = max(1, int(max_cooldown_loops)) - 1
+    stored = max(0, int(str(sdb.get(k_kill_remaining) or "0").strip() or 0))
+    remaining = min(stored, longest)
+    legacy = int(str(sdb.get(k_kill_until) or "0").strip() or 0)
+    if legacy > 0:
+        remaining = max(remaining, min(legacy - 1, longest))
+    if remaining != stored:
+        sdb.set(k_kill_remaining, str(remaining))
+    if legacy > 0:
+        sdb.set(k_kill_until, "0")
+    return remaining
+
