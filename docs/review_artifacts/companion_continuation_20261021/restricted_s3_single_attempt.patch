+def _single_attempt_s3(client):
+    try:
+        endpoint = client._endpoint
+        if not callable(endpoint._needs_retry):
+            raise TypeError("unsupported_endpoint")
+        # The pinned SDK dispatches region redirects through this hook even
+        # with total_max_attempts=1. Restrict this client, not global SDK state.
+        endpoint._needs_retry = _never_retry_s3
+        if endpoint._needs_retry is not _never_retry_s3:
+            raise TypeError("retry_control_not_applied")
+    except Exception:
+        try:
+            client.close()
+        except Exception:
+            pass
+        raise RuntimeError("restricted_s3_retry_control_unavailable") from None
+    return client
 
 
