+class FakeStore:
+    def __init__(self, snapshot):
+        self.snapshot = snapshot
+        self.seen = []
+
+    def account_reconciliation_snapshot(self):
+        return copy.deepcopy(self.snapshot)
+
+    def record_account_reconciliation_seen(self, ids):
+        self.seen.extend(ids)
