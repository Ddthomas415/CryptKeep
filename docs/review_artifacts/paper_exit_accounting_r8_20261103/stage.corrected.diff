+    h.accounting.journal.confirm(scope, row["intent_id"])
+    real = h.runner.IntentQueueSQLite.strategy_sell_intents_after
+
+    def fail(*_a, **_kw):
+        raise OSError("synthetic queue evidence unavailable")
+
+    h.mp.setattr(h.runner.IntentQueueSQLite, "strategy_sell_intents_after", fail)
+    report = _refresh(h)
+    assert report["unsettled"] is True and report["applied"] == []
+    assert _counts(h)["loss_streak"] == 0
+    assert _journal_rows(h)[0][1:3] == ("pending", 1)
+    h.mp.setattr(h.runner.IntentQueueSQLite, "strategy_sell_intents_after", real)
+    assert len(_refresh(h, accounting=_restart(h))["applied"]) == 1
