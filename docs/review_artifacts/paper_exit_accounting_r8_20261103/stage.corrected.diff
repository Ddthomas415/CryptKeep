+"""R8 written-intent accounting: real runner/helper/journal/temporary SQLite.
+
+The shared bounded harness substitutes config, quotes/signals and a minimal fill
+driver, never the runner loop or accounting helper. Counters are provisional
+written-sell reference-price metrics, not fills or realized profit. Set
+CBP_MULTISYMBOL_BEFORE_SOURCE to the saved R8 runner for failure-before proof.
+No service, process, private configuration or production file is used.
+"""
+from __future__ import annotations
+
+import builtins
+import copy
+from importlib.machinery import SourceFileLoader
+import importlib.util
+import io
+import json
+from pathlib import Path
+import sqlite3
+from types import SimpleNamespace
+
+import pytest
+
+from tests.test_runner_multi_symbol_integration import (
+    PRICES, STRATEGY, SYMBOLS, TS, VENUE, harness as _base_harness,
+)
+
+
+BTC = SYMBOLS[0]
+LIMITS = {"max_consecutive_losing_exits": 3, "max_strategy_drawdown_pct": 1000.0,
+          "performance_kill_cooldown_loops": 50}
+
+
+@pytest.fixture
+def flow(monkeypatch, tmp_path):
+    real_spec = importlib.util.spec_from_file_location
+
+    def spec(name, path, **kwargs):
+        if str(path).endswith(".before"):
+            kwargs["loader"] = SourceFileLoader(name, str(path))
+        return real_spec(name, path, **kwargs)
+
+    monkeypatch.setattr(importlib.util, "spec_from_file_location", spec)
+    h = _base_harness.__wrapped__(monkeypatch, tmp_path)
+    h.stop = SimpleNamespace(turn=0)
+    h.consume = lambda: None
+    h.cfg["risk"] = dict(LIMITS)
+    import services.execution.paper_exit_accounting as accounting
+    import services.strategies.signal_input_capture as capture
+    import storage.intent_queue_sqlite as queue_store
+    import storage.strategy_state_sqlite as state_store
+
+    monkeypatch.setattr(capture, "_runner_commit_identity", lambda: None)
+    for owner in (builtins, io):
+        real_open = owner.open
+
+        def guarded(path, *args, _open=real_open, **kwargs):
+            if isinstance(path, (str, Path)):
+                p = Path(path)
+                assert not (p.name.startswith(".env") or p.name in {
+                    ".browser-access-token", ".browser-compose-override.json"}
+                    or (p.name == "user.yaml" and p.parent.name == "config")), p
+            return _open(path, *args, **kwargs)
+
+        monkeypatch.setattr(owner, "open", guarded)
+    h.accounting_lib = accounting
+    h.queue_store = queue_store
+    h.state_store = state_store
+    h.capture = capture
+    h.accounting = accounting.PaperExitAccounting(h.state, h.queue)
+    return h
+
+
+def _scope(h, symbol=BTC, venue=VENUE, strategy=STRATEGY):
+    return h.accounting_lib.scope_for(venue, symbol, strategy)
+
+
+def _counts(h, symbol=BTC, venue=VENUE, strategy=STRATEGY):
+    keys = h.accounting_lib.counter_keys(_scope(h, symbol, venue, strategy))
+    return {name: float(h.state.get(key) or 0) for name, key in keys.items()}
+
+
+def _refresh(h, *, symbol=BTC, venue=VENUE, strategy=STRATEGY, accounting=None):
+    return (accounting or h.accounting).refresh(
+        venue=venue, symbol=symbol, strategy=strategy, limits=LIMITS)
+
+
+def _restart(h):
+    h.accounting = h.accounting_lib.PaperExitAccounting(
+        h.runner.StrategyStateSQLite(), h.runner.IntentQueueSQLite())
+    return h.accounting
+
+
+def _event(h, identity, *, price=99.0, symbol=BTC, venue=VENUE, strategy=STRATEGY,
+           status="queued", event=None):
+    event = event if event is not None else h.accounting_lib.make_event(
+        scope=_scope(h, symbol, venue, strategy), entry_price=100.0,
+        current_price=price, created_ts=TS)
+    row = {"intent_id": identity, "ts": TS, "created_ts": TS, "source": "strategy",
+           "symbol": symbol, "venue": venue, "strategy_id": strategy, "side": "sell",
+           "action": "sell", "order_type": "market", "qty": 0.5,
+           "status": status, "meta": {"exit_event": event, "reference_price": price}}
+    h.queue.upsert_intent(row)
+    return row
+
+
+def _journal_rows(h):
+    # Open through the real journal first so an empty database is valid evidence.
+    h.accounting.journal.status_of("absent")
+    with sqlite3.connect(h.state_store.DB_PATH) as db:
+        return db.execute(
+            "SELECT intent_id,status,confirmed,quarantined,payload FROM exit_events ORDER BY seq"
+        ).fetchall()
+
