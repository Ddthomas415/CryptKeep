+@pytest.mark.parametrize("damage", ["json", "list", "nan", "infinite", "wrong_pnl", "wrong_scope", "wrong_loss"])
+def test_invalid_queue_evidence_is_preserved_quarantined_and_blocks_later_events(flow, damage):
+    h = flow
+    first = _event(h, "damaged")
+    event = copy.deepcopy(first["meta"]["exit_event"])
+    if damage == "json":
+        raw = "{"
+    elif damage == "list":
+        raw = "[]"
+    else:
+        field, value = {"nan": ("pnl_pct", float("nan")),
+                        "infinite": ("current_price", float("inf")),
+                        "wrong_pnl": ("pnl_pct", 100.0),
+                        "wrong_scope": ("scope", "coinbase:ETH/USD:ema_cross"),
+                        "wrong_loss": ("is_loss", "false")}[damage]
+        event[field] = value
+        raw = json.dumps({"exit_event": event})
+    with sqlite3.connect(h.queue_store.DB_PATH) as db:
+        db.execute("UPDATE trade_intents SET meta=? WHERE intent_id='damaged'", (raw,))
+    _event(h, "later-valid")
+    report = _refresh(h)
+    assert report["unsettled"] is True and report["applied"] == []
+    assert _counts(h)["loss_streak"] == 0
+    unresolved = h.accounting.journal.unresolved(_scope(h))
+    assert [r["intent_id"] for r in unresolved] == ["damaged", "later-valid"]
+    assert unresolved[0]["quarantined"] is True and unresolved[0]["confirmed"] is True
+    if damage in {"json", "list"}:
+        assert unresolved[0]["raw"] == raw
+    assert h.queue.strategy_sell_intents_after(BTC, 0)[0]["meta_raw"] == raw
+    assert _refresh(h, accounting=_restart(h))["unsettled"] is True
+    assert _counts(h)["loss_streak"] == 0
