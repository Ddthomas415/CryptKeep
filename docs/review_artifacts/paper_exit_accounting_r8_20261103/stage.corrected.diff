+                raise OSError("synthetic queue read failure")
+            return real(db, symbol, after)
+
+        h.mp.setattr(h.runner.IntentQueueSQLite, "strategy_sell_intents_after", fail)
+    elif uncertainty == "journal":
+        def fail(_self):
+            raise OSError("synthetic journal read failure")
+        h.mp.setattr(h.accounting_lib.ExitEventJournal, "_connect", fail)
