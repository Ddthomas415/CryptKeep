+                (int(after_rowid), through_rowid, through_rowid, int(limit)),
+            ).fetchall()
+            keys = ("rowid", "fill_id", "order_id", "ts", "price", "qty", "fee", "fee_currency")
+            return [dict(zip(keys, row)) for row in rows]
+        finally:
+            con.close()
