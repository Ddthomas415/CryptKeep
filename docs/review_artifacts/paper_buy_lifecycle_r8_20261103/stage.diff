+        with sqlite3.connect(store.DB_PATH) as con:
+            con.execute("UPDATE paper_orders SET created_ts=? WHERE order_id=?",
+                        (legacy, row["order_id"]))
+    return db.get_order_by_client_id(row["client_order_id"])
