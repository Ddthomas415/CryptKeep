+def fill(db, order, *, clock=lambda: CREATED + timedelta(seconds=30), **changes):
+    args = dict(order=order, ts="2000-01-01T00:00:00Z", price=100.0,
+                qty=1.0, fee=1.0, fee_currency="USD", clock=clock)
+    args.update(changes)
+    return db.apply_fill(**args)
