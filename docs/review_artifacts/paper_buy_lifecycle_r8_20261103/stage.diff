+        assert inside_lock.wait(3)
+        second = pool.submit(fill, db, order) if winner == "expiry" else pool.submit(expire, lambda: CREATED + timedelta(seconds=120))
+        release.set()
+        one, two = first.result(timeout=5), second.result(timeout=5)
