+def _paper_buy_age_verdict(created_ts, meta_json, now_ts, queue_created_ts=None, *, queue_origins=()) -> dict:
+    if meta_json is None or (isinstance(meta_json, str) and meta_json.strip() == "null"):
+        meta = None
+    else:
+        meta = _decode_payload(meta_json)
+        if meta is None:
