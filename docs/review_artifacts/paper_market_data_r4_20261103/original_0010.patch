+"""A symbol is priced only from its own tick, never from another symbol's quote."""
+from __future__ import annotations
+
+import json
+import time
+
+import pytest
+
+from services.market_data import tick_reader
+from tests.test_strategy_runtime_runner import _reload_strategy_runner
+
+
+def _real_shape(now_ms):
+    """The shape of the operator's snapshot on 2026-10-03: one tick, one venue row."""
+    return {
+        "ts": "2026-10-03T00:01:21+00:00", "ts_ms": now_ms,
+        "venues": {"coinbase": {"bid": 84515.06, "ask": 84516.14, "last": 84516.14, "timestamp": now_ms, "ok": True}},
+        "ticks": [{"venue": "coinbase", "symbol": "BTC/USDT", "bid": 84515.06, "ask": 84516.14, "last": 84516.14, "ts_ms": now_ms}],
+    }
+
+
+@pytest.fixture
+def snapshot(monkeypatch, tmp_path):
+    path = tmp_path / "system_status.latest.json"
+    now_ms = int(time.time() * 1000)
+    path.write_text(json.dumps(_real_shape(now_ms)), encoding="utf-8")
+    monkeypatch.setattr(tick_reader, "LATEST", path)
+    return now_ms
+
+
+def test_symbol_with_its_own_tick_is_returned(snapshot):
+    assert tick_reader.get_best_bid_ask_last("coinbase", "BTC/USDT") == {
+        "ts_ms": snapshot, "bid": 84515.06, "ask": 84516.14, "last": 84516.14,
+    }
+
+
+@pytest.mark.parametrize("symbol", ["SOL/USD", "ORCA/USD", "ADA/EUR", "BTC/USD", "XRP/EUR", "BTC/USDC", "BTCUSDT", "USDT/BTC"])
+def test_symbol_without_its_own_tick_has_no_quote(snapshot, symbol):
+    assert tick_reader.get_best_bid_ask_last("coinbase", symbol) is None
+
+
+@pytest.mark.parametrize("symbol", ["btc/usdt", "BTC-USDT", " btc-usdt "])
+def test_same_symbol_in_another_spelling_is_matched(snapshot, symbol):
+    assert tick_reader.get_best_bid_ask_last("coinbase", symbol)["bid"] == 84515.06
+
+
+def _write(monkeypatch, tmp_path, snap):
+    path = tmp_path / "snap.json"
+    path.write_text(json.dumps(snap), encoding="utf-8")
+    monkeypatch.setattr(tick_reader, "LATEST", path)
+
+
+VENUE_ROW = {"coinbase": {"bid": 1.0, "ask": 2.0, "last": 1.5, "timestamp": 7, "ok": True}}
+
+
+def test_missing_symbol_in_a_snapshot_with_several_ticks_has_no_quote(monkeypatch, tmp_path):
+    # The production shape of the defect: several symbols published, one missing.
+    _write(monkeypatch, tmp_path, {"ts_ms": 7, "venues": VENUE_ROW, "ticks": [
+        {"venue": "coinbase", "symbol": "BTC/USD", "bid": 1.0, "ask": 2.0, "last": 1.5, "ts_ms": 7},
+        {"venue": "coinbase", "symbol": "ETH/USD", "bid": 3.0, "ask": 4.0, "last": 3.5, "ts_ms": 7},
+    ]})
+
+    assert tick_reader.get_best_bid_ask_last("coinbase", "XRP/EUR") is None
+    assert tick_reader.get_best_bid_ask_last("coinbase", "ETH/USD")["bid"] == 3.0
+
+
+@pytest.mark.parametrize("ticks", [[], None, "x"])
+def test_empty_or_missing_tick_list_has_no_quote(monkeypatch, tmp_path, ticks):
+    snap = {"ts_ms": 7, "venues": VENUE_ROW}
+    if ticks is not None:
+        snap["ticks"] = ticks
+    _write(monkeypatch, tmp_path, snap)
+
+    assert tick_reader.get_best_bid_ask_last("coinbase", "BTC/USD") is None
+
+
+def test_tick_without_bid_and_ask_is_returned_as_is_not_replaced_by_the_venue_row(monkeypatch, tmp_path):
+    _write(monkeypatch, tmp_path, {"ts_ms": 7, "venues": VENUE_ROW, "ticks": [
+        {"venue": "coinbase", "symbol": "BTC/USD", "bid": None, "ask": None, "last": None, "ts_ms": 7},
+    ]})
+
+    assert tick_reader.get_best_bid_ask_last("coinbase", "BTC/USD") == {"ts_ms": 7, "bid": None, "ask": None, "last": None}
+
+
+def test_last_matching_tick_wins_and_venue_spelling_is_tolerated(monkeypatch, tmp_path):
+    _write(monkeypatch, tmp_path, {"ticks": [
+        {"venue": "coinbase", "symbol": "BTC/USD", "bid": 1.0, "ask": 2.0, "last": 1.5, "ts_ms": 7},
+        {"venue": " Coinbase ", "symbol": "BTC/USD", "bid": 5.0, "ask": 6.0, "last": 5.5, "ts_ms": 8},
+    ]})
+
+    assert tick_reader.get_best_bid_ask_last("COINBASE", "BTC/USD")["bid"] == 5.0
+
+
+def test_another_venues_tick_is_not_returned(snapshot):
+    assert tick_reader.get_best_bid_ask_last("kraken", "BTC/USDT") is None
+
+
+def _runner_cfg(symbol, *, fallback):
+    return {"venue": "coinbase", "symbol": symbol, "max_tick_age_sec": 5.0, "use_ccxt_fallback": fallback}
+
+
+def test_runner_gets_no_price_for_a_symbol_without_a_tick(snapshot, monkeypatch, tmp_path):
+    runner = _reload_strategy_runner(monkeypatch, tmp_path)
+
+    assert runner._fetch_mid(_runner_cfg("SOL/USD", fallback=False)) is None
+    price, ts_ms = runner._fetch_mid(_runner_cfg("BTC/USDT", fallback=False))
+    assert price == pytest.approx(84515.6)
+    assert ts_ms == snapshot
+
+
+def test_runner_exchange_fallback_asks_for_the_same_symbol(snapshot, monkeypatch, tmp_path):
+    runner = _reload_strategy_runner(monkeypatch, tmp_path)
+    asked = []
+
+    class Exchange:
+        def fetch_ticker(self, symbol):
+            asked.append(symbol)
+            return {"bid": 150.0, "ask": 152.0, "last": 151.0, "timestamp": 42}
+
+        def close(self):
+            pass
+
+    monkeypatch.setattr(runner, "make_exchange", lambda *a, **k: Exchange())
+
+    assert runner._fetch_mid(_runner_cfg("SOL/USD", fallback=True)) == (151.0, 42)
+    assert asked == ["SOL/USD"]
+
+
+def test_paper_engine_gets_no_price_for_a_symbol_without_a_tick(snapshot, monkeypatch, tmp_path):
+    _reload_strategy_runner(monkeypatch, tmp_path)
+    from services.execution import paper_engine
+
+    engine = paper_engine.PaperEngine()
+    engine.cfg["use_ccxt_fallback"] = False
+
+    assert engine._price("coinbase", "ADA/EUR") is None
+    assert engine._price("coinbase", "BTC/USDT")["bid"] == 84515.06
+
+
+def test_paper_market_order_for_a_symbol_without_a_tick_is_not_filled(snapshot, monkeypatch, tmp_path):
+    # In April 2026 paper orders for ADA/EUR, LTC/USD, LINK/EUR and XRP/EUR
+    # were filled at another symbol's price this way. The pre-submit gate is
+    # bypassed so the order reaches the fill step, which is what is tested.
+    _reload_strategy_runner(monkeypatch, tmp_path)
+    from services.execution import paper_engine
+
+    engine = paper_engine.PaperEngine()
+    engine.cfg["use_ccxt_fallback"] = False
+    engine.set_cash_quote(1_000_000.0)
+    monkeypatch.setattr(engine, "_pre_submit_gate", lambda **kw: (True, "ok"))
+
+    result = engine.submit_order(
+        client_order_id="no-tick-1", venue="coinbase", symbol="ADA/EUR", side="buy", order_type="market", qty=0.001,
+    )
+    assert result.get("ok") is True
+    summary = engine.evaluate_open_orders()
+
+    assert summary["open_orders_seen"] == 1
+    assert summary["filled"] == 0
+    assert float((engine.db.get_position("ADA/EUR") or {"qty": 0.0}).get("qty") or 0.0) == 0.0
+    assert engine.cash_quote() == 1_000_000.0
+
+
+def test_paper_engine_price_fetch_failure_means_no_price_not_a_crash(snapshot, monkeypatch, tmp_path):
+    _reload_strategy_runner(monkeypatch, tmp_path)
+    from services.execution import paper_engine
+
+    engine = paper_engine.PaperEngine()
+    engine.cfg["use_ccxt_fallback"] = True
+
+    def unavailable(*a, **k):
+        raise RuntimeError("no network")
+
+    monkeypatch.setattr(paper_engine, "make_exchange", unavailable)
+    assert engine._price("coinbase", "XRP/EUR") is None
+
+    class Exchange:
+        def fetch_ticker(self, symbol):
+            raise RuntimeError("bad symbol")
+
+        def close(self):
+            pass
+
+    monkeypatch.setattr(paper_engine, "make_exchange", lambda *a, **k: Exchange())
+    assert engine._price("coinbase", "XRP/EUR") is None
+
+
+def test_paper_engine_exchange_fallback_asks_for_the_same_symbol(snapshot, monkeypatch, tmp_path):
+    _reload_strategy_runner(monkeypatch, tmp_path)
+    from services.execution import paper_engine
+
+    asked = []
+
+    class Exchange:
+        def fetch_ticker(self, symbol):
+            asked.append(symbol)
+            return {"bid": 0.5, "ask": 0.7, "last": 0.6, "timestamp": 9}
+
+        def close(self):
+            pass
+
+    engine = paper_engine.PaperEngine()
+    engine.cfg["use_ccxt_fallback"] = True
+    monkeypatch.setattr(paper_engine, "make_exchange", lambda *a, **k: Exchange())
+
+    assert engine._price("coinbase", "XRP/EUR") == {"ts_ms": 9, "bid": 0.5, "ask": 0.7, "last": 0.6}
+    assert asked == ["XRP/EUR"]
+
+
+def test_real_pre_submit_gate_refuses_a_market_order_for_a_symbol_without_a_tick(snapshot, monkeypatch, tmp_path):
+    _reload_strategy_runner(monkeypatch, tmp_path)
+    from services.execution import paper_engine
+    from services.risk import staleness_guard
+
+    monkeypatch.setattr(staleness_guard, "LATEST_SNAPSHOT", tick_reader.LATEST)
+    engine = paper_engine.PaperEngine()
+    engine.set_cash_quote(1_000_000.0)
+
+    result = engine.submit_order(
+        client_order_id="no-tick-2", venue="coinbase", symbol="ADA/EUR", side="buy", order_type="market", qty=0.001,
+    )
+
+    assert result.get("ok") is not True
+    assert "no_reference_price" in str(result)
+
+
+@pytest.mark.parametrize("block, ok", [(False, True), (True, False)])
+def test_market_quality_guard_reports_no_quote_for_a_symbol_without_a_tick(snapshot, monkeypatch, block, ok):
+    # With the default setting the guard lets an unknown quote through
+    # unchecked; only block_when_unknown refuses it. Pinned so that the
+    # setting's effect is explicit.
+    from services.risk import market_quality_guard
+
+    real = market_quality_guard._cfg if hasattr(market_quality_guard, "_cfg") else None
+    assert real is not None
+    monkeypatch.setattr(market_quality_guard, "_cfg", lambda: {**real(), "block_when_unknown": block})
+
+    out = market_quality_guard.check("coinbase", "ADA/EUR")
+
+    assert out["reason"] == "no_quote_data"
+    assert out["ok"] is ok
+
+
+def test_tick_written_in_another_spelling_is_matched(monkeypatch, tmp_path):
+    _write(monkeypatch, tmp_path, {"ticks": [
+        {"venue": "coinbase", "symbol": "btc-usd", "bid": 1.0, "ask": 2.0, "last": 1.5, "ts_ms": 7},
+    ]})
+
+    assert tick_reader.get_best_bid_ask_last("coinbase", "BTC/USD")["bid"] == 1.0
