+++ b/tests/test_review_currency_config_failure.py
@@ -0,0 +1,59 @@
+import pytest
+
+from services.admin import config_editor
+from services.execution import paper_engine
+
+
+@pytest.mark.parametrize('content', ['paper_trading: [unterminated\n', '[]\n', 'paper_trading: []\n', 'paper_trading: null\n'])
+def test_invalid_yaml_does_not_disable_currency_guard(monkeypatch, tmp_path, content):
+    path = tmp_path / 'user.yaml'
+    path.write_text(content)
+    monkeypatch.setattr(config_editor, 'CONFIG_PATH', path)
+    engine = object.__new__(paper_engine.PaperEngine)
+    engine.cfg = paper_engine._cfg()
+    assert engine._currency_refusal('buy', 'ADA/EUR') is not None
+    assert engine._currency_refusal('sell', 'ADA/EUR') is None
+
+
+def test_invalid_section_does_not_disable_currency_guard(monkeypatch):
+    monkeypatch.setattr(paper_engine, 'load_user_yaml', lambda **kwargs: {'paper_trading': ['USDT']})
+    engine = object.__new__(paper_engine.PaperEngine)
+    engine.cfg = paper_engine._cfg()
+    assert engine._currency_refusal('buy', 'ADA/EUR') is not None
+
+
+def test_unreadable_file_refuses_buys(monkeypatch, tmp_path):
+    from pathlib import Path
+    path = tmp_path / 'user.yaml'
+    path.write_text('paper_trading:\n  quote_currency: USDT\n')
+    monkeypatch.setattr(config_editor, 'CONFIG_PATH', path)
+    original = Path.open
+    def denied(self, *args, **kwargs):
+        if self == path:
+            raise PermissionError('test read failure')
+        return original(self, *args, **kwargs)
+    monkeypatch.setattr(Path, 'open', denied)
+    engine = object.__new__(paper_engine.PaperEngine)
+    engine.cfg = paper_engine._cfg()
+    assert engine._currency_refusal('buy', 'BTC/USDT') == 'quote_currency_invalid'
+    assert engine._currency_refusal('sell', 'BTC/USDT') is None
+
+
+def test_invalid_restart_rejects_resting_buy_but_fills_sell(monkeypatch, tmp_path):
+    from tests.test_paper_engine_currency import _engine, _buy
+    engine, _ = _engine(monkeypatch, tmp_path, None)
+    engine.db.upsert_position('ADA/EUR', 0.001, 9.0, 0.0)
+    assert _buy(engine, 'ADA/EUR')['ok']
+    assert engine.submit_order(client_order_id='s1', venue='coinbase', symbol='ADA/EUR', side='sell', order_type='market', qty=0.001)['ok']
+    # Resolve the reloaded module used by the fixture.
+    from services.execution import paper_engine as current
+    monkeypatch.setattr(current, 'load_user_yaml', lambda **kwargs: {'paper_trading': []})
+    restarted = current.PaperEngine()
+    monkeypatch.setattr(restarted, '_price', lambda *args: {'ts_ms': 1, 'bid': 9.0, 'ask': 9.1, 'last': 9.05})
+    assert _buy(restarted, 'ADA/EUR', coid='new') == {'ok': False, 'reason': 'quote_currency_invalid'}
+    assert restarted.db.get_order_by_client_id('new') is None
+    result = restarted.evaluate_open_orders()
+    assert result['rejected'] == 1
+    assert result['filled'] == 1
+    assert restarted.db.get_order_by_client_id('c1')['status'] == 'rejected'
+    assert restarted.db.get_order_by_client_id('s1')['status'] == 'filled'
