--- /dev/null
+++ b/tests/test_review_exit_event_loss.py
@@ -0,0 +1,20 @@
+from tests.test_runner_exit_accounting_event import (
+    _holding, HOLD, KEY, _faithful_queue, _keep_holding,
+    _stop_between_write_and_record, _run,
+)
+
+
+def test_two_written_losses_preserve_third_loss_kill(monkeypatch, tmp_path):
+    runner, emitted, state = _holding(monkeypatch, tmp_path, signal=HOLD)
+    _faithful_queue(monkeypatch, runner, emitted)
+    _keep_holding(monkeypatch, runner, emitted)
+    state.set(f'loss_streak:{KEY}', '1')
+    _stop_between_write_and_record(monkeypatch, runner)
+    def unreadable(self, *args, **kwargs):
+        raise RuntimeError('queue read failure')
+    for name in ('get_intent', 'list_intents', 'has_open_strategy_intent'):
+        monkeypatch.setattr(runner.IntentQueueSQLite, name, unreadable)
+    _run(monkeypatch, runner, loops=1)
+    assert len(emitted) == 2
+    actual = (state.get(f'loss_streak:{KEY}'), int(state.get(f'kill_remaining:{KEY}') or '0') > 0)
+    assert actual == ('3', True)
