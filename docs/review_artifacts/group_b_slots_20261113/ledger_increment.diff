+    def slot_snapshot(self) -> dict:
+        """Complete read-only ownership evidence for a single Group B account."""
+        con = sqlite3.connect(DB_PATH.resolve().as_uri() + "?mode=ro", uri=True, timeout=5)
+        try:
+            con.execute("BEGIN")
+            positions = con.execute(
+                "SELECT symbol,qty FROM paper_positions WHERE qty IS NULL "
+                "OR typeof(qty) NOT IN ('real','integer') OR qty != 0").fetchall()
+            orders = con.execute(
+                "SELECT symbol FROM paper_orders WHERE status IS NULL OR status NOT IN "
+                "('filled','rejected','cancelled','canceled','expired')").fetchall()
+            return {"positions": [{"symbol": s, "qty": q} for s, q in positions],
+                    "open_order_symbols": [s for (s,) in orders]}
         finally:
             con.close()
 
