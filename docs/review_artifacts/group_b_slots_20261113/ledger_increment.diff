+    def refuse_group_b_buy(self, client_order_id: str, *, expected_order: dict, now: Any) -> dict:
+        """Fence selection refusal before queue disposal; never replace filled truth."""
+        from services.execution.paper_weekly_slot import buy_selection_verdict
+        con = _connect()
+        try:
+            con.execute("BEGIN IMMEDIATE")
+            existing = self._exit_order_conn(con, client_order_id=str(client_order_id))
+            if existing is not None:
+                if (not self._paper_buy_order_matches(existing, expected_order)
+                        or existing.get("strategy_id") != expected_order.get("strategy_id")
+                        or (existing.get("meta") or {}).get("group_b_selection") != (expected_order.get("meta") or {}).get("group_b_selection")):
+                    con.rollback()
+                    return {"state": "blocked", "reason": "group_b:order_identity"}
+                if existing["status"] == "filled":
+                    receipt = self._committed_fill_receipt_conn(con, existing["order_id"], existing["qty"])
+                    con.execute("COMMIT")
+                    return {"state": "filled" if receipt["ok"] else "blocked", "order": existing}
+            terminal = self._paper_buy_terminal_conn(con, str(client_order_id))
+            if terminal is not None:
+                con.execute("COMMIT")
+                return {**terminal, "order": existing}
+            verdict = buy_selection_verdict(meta=expected_order.get("meta"), venue=expected_order.get("venue"),
+                                            symbol=expected_order.get("symbol"), strategy_id=expected_order.get("strategy_id"),
+                                            now=now, guard=True)
+            if verdict["ok"]:
+                con.execute("COMMIT")
+                return {"state": "authorized", "order": existing}
+            if existing is not None and existing["status"] not in {"new", "open"}:
+                con.rollback()
+                return {"state": "blocked", "reason": "group_b:order_state", "order": existing}
+            self._write_paper_buy_terminal_conn(con, str(client_order_id), "rejected", verdict["reason"], expected_order.get("created_ts"))
+            if existing is not None:
+                self._update_order_status_conn(con, existing["order_id"], "rejected", verdict["reason"])
+                existing.update(status="rejected", reject_reason=verdict["reason"])
+            con.execute("COMMIT")
+            return {"state": "rejected", "reason": verdict["reason"], "order": existing}
+        except Exception:
+            con.rollback()
+            raise
+        finally:
+            con.close()
 
