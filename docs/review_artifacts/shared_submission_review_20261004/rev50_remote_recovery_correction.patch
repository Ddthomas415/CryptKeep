+@pytest.mark.parametrize("gate", ["market_quality", "market_quality_error", "symbol_lock"])
+@pytest.mark.parametrize("age_s", [5, 3600])
+def test_remote_order_is_recovered_before_pre_submit_blocks(rig, monkeypatch, gate, age_s):
+    cfg, store, client = rig
+    _add(store, "sent-blocked", age_s, reason="remote_id=ord-77")
+    if gate == "market_quality":
+        monkeypatch.setattr(le, "check_market_quality", lambda *_a, **_k: (False, "stale"))
+    elif gate == "market_quality_error":
+        def broken_quality(*_args, **_kwargs):
+            raise RuntimeError("quote unavailable")
+        monkeypatch.setattr(le, "check_market_quality", broken_quality)
+    else:
+        store.set_symbol_lock("BTC/USD", int((time.time() + 3600) * 1000), 1, "test")
+    for _ in range(2):
+        out = le.submit_pending_live(cfg)
+        assert out["expired"] == 0
+        assert out["submitted"] == 0
+        assert _status(store, "sent-blocked") == ("submitted", "remote_id=ord-77")
+        assert client.calls == []
