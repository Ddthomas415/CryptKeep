+def classifier(path=APPLICATION):
+    source = ast.parse(path.read_bytes())
+    node = next(n for n in source.body if isinstance(n, ast.FunctionDef) and n.name == "_is_ambiguous_submit_error")
+    module = ast.Module(body=[node], type_ignores=[]); ast.fix_missing_locations(module)
+    ns = {"ccxt": ccxt, "is_retryable_exception": is_retryable_exception}
+    exec(compile(module, str(path), "exec"), ns)
+    return ns["_is_ambiguous_submit_error"]
+
+
+def test_sdk_network_subclass_is_uncertain_even_with_a_different_class_name():
+    assert classifier()(ccxt.OnMaintenance("invented exchange maintenance")) is True
+
+
+class DifferentTransportName(ccxt.NetworkError):
+    pass
+
+
+@pytest.mark.parametrize("error_type", [ccxt.NetworkError, ccxt.RequestTimeout, ccxt.ExchangeNotAvailable,
+    ccxt.OnMaintenance, ccxt.DDoSProtection, ccxt.RateLimitExceeded, ccxt.BadResponse, ccxt.NullResponse,
+    ccxt.CancelPending, ccxt.InvalidNonce, DifferentTransportName, ConnectionError, ConnectionResetError, TimeoutError])
+def test_transport_and_operation_types_remain_uncertain_regardless_of_message(error_type):
+    for message in ("account rejected", "invalid order", "unrelated 429 value"):
+        assert classifier()(error_type(message)) is True
+
+
+@pytest.mark.parametrize("error_type", [ccxt.AuthenticationError, ccxt.PermissionDenied, ccxt.AccountSuspended,
+    ccxt.InvalidOrder, ccxt.InsufficientFunds, ccxt.BadRequest, ccxt.BadSymbol, ccxt.ArgumentsRequired,
+    ccxt.NotSupported, ccxt.OperationRejected])
+def test_known_rejections_do_not_become_transport_failures_from_message_text(error_type):
+    for message in ("timeout", "503 temporary", "connection reset"):
+        assert classifier()(error_type(message)) is False
+
+
+@pytest.mark.parametrize("error_type", [ccxt.OnMaintenance, DifferentTransportName, ConnectionResetError,
+                                      ccxt.BadResponse, ccxt.InvalidNonce])
+@pytest.mark.parametrize("outcome", ["inconclusive", "confirmed_not_placed", "confirmed_placed"])
+def test_typed_submit_failure_requires_reconciliation_and_positive_retry_eligibility(tmp_path, error_type, outcome):
+    error = error_type("invented transport or operation failure")
+    def submit():
+        raise error
+    invoke, trace, store, safe_retry = harness(tmp_path, submit=submit, reconcile=outcome)
+    with pytest.raises(RuntimeError) as raised:
+        invoke()
+    expected_retry_signal = outcome == "confirmed_not_placed" and is_retryable_exception(error)
+    assert isinstance(raised.value, safe_retry) is expected_retry_signal
+    assert store.get_by_intent("coinbase", "exit-1")["status"] == "unknown"
+    assert ("reconcile", None) in trace and trace[-1] == "close"
+    before = list(trace)
+    with pytest.raises(RuntimeError, match="idempotency blocks"):
+        invoke()
+    assert trace == before
+
+
+def test_old_exact_name_classifier_misses_real_sdk_and_builtin_subclasses():
+    source = ROOT / "docs/review_artifacts/exchange_error_types_20261028/exchange_client.py"
+    old = classifier(source)
+    assert old(ccxt.OnMaintenance("invented")) is False
+    assert old(ConnectionResetError("invented")) is False
+
+
+def test_invalid_nonce_uncertainty_does_not_relax_its_existing_no_retry_rule():
+    error = ccxt.InvalidNonce("invented nonce refusal")
+    assert classifier()(error) is True and is_retryable_exception(error) is False
