+
+
+def test_final_receipt_write_failure_releases_lock_but_blocks_new_acquisition(prepared,monkeypatch):
+    original=slot._write
+    def fail(path,value):
+        if path.name=="RESULT.json":raise OSError("invented full filesystem")
